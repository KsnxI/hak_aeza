VITE_USE_MOCK=true
APP_NAME=Churn Risk Analyzer
APP_ENV=development

POSTGRES_DB=churn_db
POSTGRES_USER=churn_user
POSTGRES_PASSWORD=local_dev_password_change_me

DATABASE_URL=postgresql+psycopg://churn_user:local_dev_password_change_me@db:5432/churn_db

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SESSION_TTL_HOURS=8
SESSION_COOKIE_NAME=churn_session
SESSION_COOKIE_SECURE=false
TRUSTED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:5173","http://127.0.0.1:5173"]